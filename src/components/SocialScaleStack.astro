---
import { siGithub, siInstagram, siX } from "simple-icons";

const scalePath =
  "M32 -9 C36 9 49 20 64 27 C64 51 51 68 32 77 C13 68 0 51 0 27 C15 20 28 9 32 -9 Z";

const siLinkedIn = {
  title: "LinkedIn",
  path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
};

const socials = [
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/woodward-ben/",
    icon: siLinkedIn,
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/benjawo/",
    icon: siInstagram,
  },
  {
    label: "X",
    href: "https://x.com/benjaminbuilt",
    icon: siX,
  },
  {
    label: "GitHub",
    href: "https://github.com/benjaminwoodward",
    icon: siGithub,
  },
];
---

<nav class="social-scale-stack" aria-label="Social links" data-social-scale-stack>
  {
    socials.map((item) => (
      <a
        class="social-scale"
        href={item.href}
        aria-label={item.label}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg
          class="social-scale__shape"
          viewBox="0 -10 64 88"
          aria-hidden="true"
          focusable="false"
        >
          <path d={scalePath} />
        </svg>

        <svg
          class="social-scale__icon"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path d={item.icon.path} />
        </svg>
      </a>
    ))
  }
</nav>

<script>
  (() => {
    const compactQuery = window.matchMedia("(max-width: 680px)");
    const stacks = Array.from(document.querySelectorAll<HTMLElement>("[data-social-scale-stack]"));

    if (!stacks.length) return;

    const collapseStacks = () => {
      stacks.forEach((stack) => {
        stack.classList.remove("is-expanded");
        stack.setAttribute("aria-expanded", "false");
      });
    };

    const expandStack = (stack: HTMLElement) => {
      stack.classList.add("is-expanded");
      stack.setAttribute("aria-expanded", "true");
    };

    stacks.forEach((stack) => {
      stack.setAttribute("aria-expanded", "false");

      stack.addEventListener(
        "click",
        (event) => {
          if (!compactQuery.matches || stack.classList.contains("is-expanded")) return;

          event.preventDefault();
          event.stopPropagation();
          expandStack(stack);
        },
        true,
      );
    });

    document.addEventListener("pointerdown", (event) => {
      if (!compactQuery.matches) return;

      const target = event.target;
      if (!(target instanceof Node)) return;
      if (stacks.some((stack) => stack.contains(target))) return;

      collapseStacks();
    });

    compactQuery.addEventListener("change", () => {
      if (!compactQuery.matches) collapseStacks();
    });
  })();
</script>
