---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props { file: string; alt: string; class?: string; sizes?: string; }
const { file, alt, class: className, sizes = "(max-width: 700px) calc(100vw - 40px), (max-width: 1400px) 45vw, 608px" } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/story/*.{jpg,png}", { eager: true });
const image = images[`../assets/story/${file}`]?.default;
if (!image) throw new Error(`Missing story photo: ${file}`);
---
<Image src={image} alt={alt} widths={[320, 640, 1000]} sizes={sizes} format="webp" quality={82} loading="lazy" decoding="async" class={className} />
