---
import DecryptedText from "./DecryptedText.jsx";

type MemoryFrame = {
  src: string;
  alt: string;
  kind?: "photo" | "logo" | "video";
  href?: string;
  logoSize?: "default" | "compact";
  enterSrc?: string;
  exitSrc?: string;
  aspectRatio?: string;
};

type HeroDispatch = {
  eyebrow: string;
  age: string;
  text: string;
  memoryFrames?: MemoryFrame[];
};

const childhoodFrames: MemoryFrame[] = [
  { src: "/ben-child-car.jpg", alt: "Benjamin as a child building a wooden car" },
  { src: "/ben-child-diagram.jpg", alt: "A childhood engineering diagram sketched by Benjamin" },
  { src: "/ben-child-welding.jpg", alt: "Benjamin welding as a younger builder" },
];

const builderFrames: MemoryFrame[] = [
  { src: "/ben-builder-robot-arm.jpg", alt: "A robotic arm Benjamin built as a young builder" },
  { src: "/ben-builder-seismometer.jpg", alt: "A homemade seismometer electronics build" },
  { src: "/ben-builder-electric-car.jpg", alt: "A small electric car prototype" },
];

const hackathonFrames: MemoryFrame[] = [
  { src: "/hackathon-just-build.png", alt: "JustBuild hackathon logo", kind: "logo" },
  { src: "/hackathon-defhacks.png", alt: "DefHacks logo", kind: "logo" },
  { src: "/hackathon-byu-cutout.png", alt: "BYU logo", kind: "logo" },
  { src: "/hackathon-billboard.jpg", alt: "A Redo billboard naming Benjamin as an AI hackathon winner" },
  { src: "/hackathon-win.jpg", alt: "Benjamin after winning first place at an AI hackathon" },
];

const missionFrames: MemoryFrame[] = [
  { src: "/mission-tampere.jpg", alt: "Benjamin by the river in Tampere, Finland during his mission" },
  { src: "/mission-temple.jpg", alt: "Benjamin outside a temple in Finland during his mission" },
  { src: "/mission-rollers.jpg", alt: "Benjamin rollerblading with a mission companion in Finland" },
  { src: "/mission-snow-group.jpg", alt: "Benjamin with mission friends in snowy Finland" },
];

const marathonFrames: MemoryFrame[] = [
  { src: "/marathon.jpg", alt: "Benjamin after running the Helsinki Marathon" },
];

const waterQualityFrames: MemoryFrame[] = [
  {
    src: "/pureflow-enter.webm",
    enterSrc: "/pureflow-enter.webm",
    exitSrc: "/pureflow-exit.webm",
    alt: "Pureflow water-quality software landing page demo",
    kind: "video",
    aspectRatio: "1 / 1",
  },
];

const redoFrames: MemoryFrame[] = [
  {
    src: "/redo-logo-knockout.svg",
    alt: "Redo logo",
    kind: "logo",
    href: "https://redo.com",
    logoSize: "compact",
  },
];

const heroDispatches: HeroDispatch[] = [
  {
    eyebrow: "Origin",
    age: "0-18",
    text: "Six countries. One obsession: building.",
    memoryFrames: childhoodFrames,
  },
  {
    eyebrow: "Builder",
    age: "8-15",
    text: "Robotics. Planes. Seismometers. Electric cars.",
    memoryFrames: builderFrames,
  },
  {
    eyebrow: "Commerce",
    age: "15",
    text: "Built a 5-figure ecommerce brand at 15.",
  },
  {
    eyebrow: "Competition",
    age: "20",
    text: "3x hackathon winner.",
    memoryFrames: hackathonFrames,
  },
  {
    eyebrow: "Mission",
    age: "20-22",
    text: "Served as an LDS (Mormon) missionary in Finland.",
    memoryFrames: missionFrames,
  },
  {
    eyebrow: "Endurance",
    age: "22",
    text: "Ran a marathon with no training. Finished in 3.5 hours.",
    memoryFrames: marathonFrames,
  },
  {
    eyebrow: "Software",
    age: "22",
    text: "Developed and sold water-quality software in a six-figure exit.",
    memoryFrames: waterQualityFrames,
  },
  {
    eyebrow: "Outbound",
    age: "22",
    text: "Scaled no-touch AI outbound to a $1.04M/year run-rate in under 2 weeks.",
  },
  {
    eyebrow: "Redo",
    age: "22",
    text: "Left BYU to join Redo, Utah's fastest-growing startup.",
    memoryFrames: redoFrames,
  },
  {
    eyebrow: "Operator",
    age: "22",
    text: "GM, AI infrastructure.",
  },
  {
    eyebrow: "Leverage",
    age: "23",
    text: "Cut merchant onboarding from 1+ week to ~20 minutes.",
  },
  {
    eyebrow: "Scale",
    age: "23",
    text: "Automated 60% of onboarding. Eight figures onboarded autonomously.",
  },
  {
    eyebrow: "Now",
    age: "Now",
    text: "Scaled fintech and fraud products across $500M+ in merchant GMV.",
  },
  {
    eyebrow: "Signal",
    age: "Now",
    text: "I build where product, capital, and operations collide.",
  },
];

const memoryFrameGroups = heroDispatches
  .map((dispatch, dispatchIndex) => {
    const frames = dispatch.memoryFrames ?? [];
    const logoFrames = frames.filter((frame) => frame.kind === "logo");
    const videoFrames = frames.filter((frame) => frame.kind === "video");
    const photoFrames = frames.filter((frame) => frame.kind !== "logo" && frame.kind !== "video");

    return {
      dispatchIndex,
      label: `${dispatch.eyebrow} images`,
      kind: videoFrames.length
        ? "video"
        : logoFrames.length && photoFrames.length
        ? "mixed"
        : logoFrames.length
          ? "logo"
          : "photo",
      frames,
      logoFrames,
      videoFrames,
      photoFrames,
    };
  })
  .filter((group) => group.frames.length > 0);

const scalePath =
  "M32 -9 C36 9 49 20 64 27 C64 51 51 68 32 77 C13 68 0 51 0 27 C15 20 28 9 32 -9 Z";
const dispatchGridLines = [1, 1, 0.22, 0, 0, 0];
const dispatchGridFills = [1, 0.86, 0.08, 0, 0];
---

<section class="hero ascii-hero" id="serpent-signal" data-ascii-hero>
  <div class="ascii-hero__sticky">
    <pre
      class="ascii-hero__output"
      data-ascii-output
      aria-label="Scroll-driven ASCII cobra animation"
    >Loading serpent signal...</pre>

    <div class="ascii-hero__copy">
      <h1 class="hero__statement">
        <DecryptedText
          client:load
          text="I build with "
          parentClassName="decrypted-text decrypted-text--title decrypted-text--hero-lead"
          className="decrypted-text__char--revealed"
          encryptedClassName="decrypted-text__char--encrypted"
          hiddenClassName="decrypted-text__char--hidden"
          revealDirection="end"
          disappearStart={0.42}
          disappearEnd={0.92}
          speed={90}
        /><em><DecryptedText
          client:load
          text="bite"
          parentClassName="decrypted-text decrypted-text--title"
          className="decrypted-text__char--revealed"
          encryptedClassName="decrypted-text__char--encrypted"
          hiddenClassName="decrypted-text__char--hidden"
          revealDirection="end"
          disappearStart={0.04}
          disappearEnd={0.34}
          fuzzyBeforeDecrypt={true}
          fuzzyProps={{
            baseIntensity: 0.18,
            hoverIntensity: 0.32,
            enableHover: false,
            fuzzRange: 12,
            fps: 28,
            direction: "horizontal",
            textPaddingStart: 0,
            textPaddingEnd: 18,
            glitchMode: true,
            glitchInterval: 1700,
            glitchDuration: 140,
            fontSize: "1em",
            fontWeight: 400,
            color: "#fff",
            className: "fuzzy-text fuzzy-text--bite",
          }}
          speed={90}
        /></em>
      </h1>
      <p class="ascii-hero__subline">
        <DecryptedText
          client:load
          text="Operator-builder across automation, fintech, and go-to-market."
          parentClassName="decrypted-text decrypted-text--subline"
          className="decrypted-text__char--revealed"
          encryptedClassName="decrypted-text__char--encrypted"
          hiddenClassName="decrypted-text__char--hidden"
          revealDirection="end"
          disappearStart={0.48}
          disappearEnd={0.96}
          speed={90}
        />
      </p>
      <p class="ascii-hero__readout" data-ascii-readout>
        Scroll to advance the signal.
      </p>
    </div>

    <div class="ascii-hero__dispatches" aria-label="Selected proof points">
      <div class="ascii-hero__dispatch-grid" aria-hidden="true">
        {
          dispatchGridFills.map((opacity, index) => (
            <span
              class="ascii-hero__dispatch-grid-fill"
              style={`--grid-fill-index: ${index}; --grid-fill-opacity: ${opacity};`}
            />
          ))
        }
        {
          dispatchGridLines.map((opacity, index) => (
            <span
              class="ascii-hero__dispatch-grid-line"
              style={`--grid-line-index: ${index}; --grid-line-opacity: ${opacity};`}
            />
          ))
        }
      </div>

      <div class="ascii-hero__dispatch-copy">
        {
          heroDispatches.map((dispatch, index) => (
            /* Keep the original strings in data attributes so scroll-driven
               encryption can mutate only the visual text. */
            <article
              class={`ascii-hero__dispatch${dispatch.memoryFrames?.some((frame) => frame.kind === "video") ? " ascii-hero__dispatch--with-proof-video" : ""}`}
              data-hero-dispatch
              data-dispatch-index={index}
              data-dispatch-scroll-weight={dispatch.memoryFrames?.some((frame) => frame.kind === "video") ? "2.75" : "1"}
              style={`--dispatch-index: ${index};`}
            >
              <p class="ascii-hero__mobile-title">{dispatch.eyebrow}</p>
              <p
                class="ascii-hero__dispatch-kicker"
                data-dispatch-kicker-text={`${(index + 1).toString().padStart(2, "0")} / ${heroDispatches.length.toString().padStart(2, "0")} ${dispatch.eyebrow}`}
                aria-label={`${(index + 1).toString().padStart(2, "0")} / ${heroDispatches.length.toString().padStart(2, "0")} ${dispatch.eyebrow}`}
              >
                {`${(index + 1).toString().padStart(2, "0")} / ${heroDispatches.length.toString().padStart(2, "0")} ${dispatch.eyebrow}`}
              </p>
              <p
                class="ascii-hero__dispatch-text"
                data-dispatch-body-text={dispatch.text}
                aria-label={dispatch.text}
              >
                {dispatch.text}
              </p>
              {
                dispatch.memoryFrames && (
                  <div
                    class="ascii-hero__mobile-memory"
                    data-memory-frame-group
                    data-memory-group-kind={dispatch.memoryFrames.some((frame) => frame.kind === "video") ? "video" : "photo"}
                    data-memory-group-surface="mobile"
                    data-memory-frame-count={dispatch.memoryFrames.filter((frame) => frame.kind !== "logo" && frame.kind !== "video").length}
                    data-memory-dispatch-index={index}
                    aria-label={`${dispatch.eyebrow} images`}
                    aria-hidden="true"
                  >
                    {
                      dispatch.memoryFrames.some((frame) => frame.kind === "logo") && (
                        <div class="ascii-hero__mobile-logo-row" aria-hidden="true">
                          {
                            dispatch.memoryFrames
                              .filter((frame) => frame.kind === "logo")
                              .map((frame) => (
                                frame.href ? (
                                  <a
                                    class="ascii-hero__mobile-logo-link"
                                    href={frame.href}
                                    aria-label={frame.alt}
                                    target="_blank"
                                    rel="noreferrer"
                                    data-logo-size={frame.logoSize ?? "default"}
                                  >
                                    <img
                                      class="ascii-hero__mobile-logo"
                                      src={frame.src}
                                      alt=""
                                      loading="lazy"
                                    />
                                  </a>
                                ) : (
                                  <img
                                    class="ascii-hero__mobile-logo"
                                    src={frame.src}
                                    alt=""
                                    loading="lazy"
                                    data-logo-size={frame.logoSize ?? "default"}
                                  />
                                )
                              ))
                          }
                        </div>
                      )
                    }
                      {
                        dispatch.memoryFrames.filter((frame) => frame.kind !== "logo" && frame.kind !== "video").length > 0 && (
                          <div
                            class="ascii-hero__mobile-memory-row"
                            data-mobile-memory-row
                            data-mobile-memory-count={dispatch.memoryFrames.filter((frame) => frame.kind !== "logo" && frame.kind !== "video").length}
                          >
                            {
                              dispatch.memoryFrames
                                .filter((frame) => frame.kind !== "logo" && frame.kind !== "video")
                                .map((frame, frameIndex) => (
                                  <figure
                                    class="ascii-hero__memory-frame ascii-hero__mobile-memory-frame"
                                    data-memory-frame
                                    data-memory-frame-kind="photo"
                                    data-memory-frame-position={frameIndex + 1}
                                    role="button"
                                    tabindex="0"
                                    aria-pressed="false"
                                    style={`--memory-frame-index: ${frameIndex};`}
                                  >
                                    <svg
                                      class="ascii-hero__memory-shield"
                                      viewBox="0 -10 64 88"
                                      preserveAspectRatio="none"
                                      aria-hidden="true"
                                      focusable="false"
                                    >
                                      <defs>
                                        <clipPath
                                          id={`mobile-memory-frame-clip-${index}-${frameIndex}`}
                                          clipPathUnits="userSpaceOnUse"
                                        >
                                          <path d={scalePath} />
                                        </clipPath>
                                      </defs>
                                      <path class="ascii-hero__memory-frame-backdrop" d={scalePath} />
                                    <image
                                      class="ascii-hero__memory-frame-image"
                                      href={frame.src}
                                      x="-1"
                                      y="-11"
                                      width="66"
                                      height="90"
                                      preserveAspectRatio="xMidYMid slice"
                                      clip-path={`url(#mobile-memory-frame-clip-${index}-${frameIndex})`}
                                    >
                                      <title>{frame.alt}</title>
                                    </image>
                                      <path class="ascii-hero__memory-frame-stroke" d={scalePath} />
                                    </svg>
                                    <figcaption class="sr-only">{frame.alt}</figcaption>
                                  </figure>
                                ))
                            }
                          </div>
                        )
                      }
                    {
                      dispatch.memoryFrames
                        .filter((frame) => frame.kind === "video")
                        .map((frame) => (
                          <figure
                            class="ascii-hero__mobile-proof-video-card"
                            data-dispatch-proof-card
                            data-dispatch-video-index={index}
                            data-dispatch-enter-src={frame.enterSrc ?? frame.src}
                            data-dispatch-exit-src={frame.exitSrc ?? frame.src}
                            style={`--proof-video-aspect: ${frame.aspectRatio ?? "16 / 9"};`}
                          >
                            <video
                              class="ascii-hero__proof-video ascii-hero__proof-video--enter"
                              data-dispatch-proof-enter
                              src={frame.enterSrc ?? frame.src}
                              muted
                              playsinline
                              preload="auto"
                              aria-label={`${frame.alt} intro`}
                            />
                            <video
                              class="ascii-hero__proof-video ascii-hero__proof-video--exit"
                              data-dispatch-proof-exit
                              src={frame.exitSrc ?? frame.src}
                              muted
                              playsinline
                              preload="auto"
                              aria-label={`${frame.alt} outro`}
                            />
                            <figcaption class="sr-only">{frame.alt}</figcaption>
                          </figure>
                        ))
                      }
                  </div>
                )
              }
            </article>
          ))
        }
      </div>

      <div class="ascii-hero__memory-frames" data-memory-frames aria-label="Timeline images">
        {
          memoryFrameGroups.map((group) => {
            const photoFrameCount = group.photoFrames.length;
            const frameGapCap =
              photoFrameCount >= 4 ? "20px" : photoFrameCount === 3 ? "28px" : "34px";
            const frameGroupStyle =
              photoFrameCount > 1
                ? `--memory-frame-hover-gap: clamp(10px, calc((var(--dispatch-column-width) - (var(--memory-frame-width) * ${photoFrameCount})) / ${photoFrameCount - 1}), ${frameGapCap});`
                : "--memory-frame-hover-gap: 0px;";

            return (
            <div
              class={`ascii-hero__memory-frame-group${group.kind === "logo" ? " ascii-hero__memory-frame-group--logos" : ""}${group.kind === "mixed" ? " ascii-hero__memory-frame-group--mixed" : ""}${group.kind === "video" ? " ascii-hero__memory-frame-group--video" : ""}`}
              data-memory-frame-group
              data-memory-group-kind={group.kind}
              data-memory-frame-count={group.photoFrames.length || group.videoFrames.length || group.frames.length}
              data-memory-dispatch-index={group.dispatchIndex}
              aria-label={group.label}
              aria-hidden="true"
              style={frameGroupStyle}
            >
              {
                group.logoFrames.length > 0 && (
                  <div class="ascii-hero__memory-logo-row">
                    {
                      group.logoFrames.map((frame, index) => (
                        <figure
                          class="ascii-hero__memory-logo-item"
                          data-logo-size={frame.logoSize ?? "default"}
                          style={`--memory-frame-index: ${index};`}
                        >
                          {
                            frame.href ? (
                              <a
                                class="ascii-hero__memory-logo-link"
                                href={frame.href}
                                aria-label={frame.alt}
                                target="_blank"
                                rel="noreferrer"
                              >
                                <img
                                  class="ascii-hero__memory-logo"
                                  src={frame.src}
                                  alt=""
                                  loading="lazy"
                                />
                              </a>
                            ) : (
                              <img
                                class="ascii-hero__memory-logo"
                                src={frame.src}
                                alt={frame.alt}
                                loading="lazy"
                              />
                            )
                          }
                        </figure>
                      ))
                    }
                  </div>
                )
              }
              {
                group.photoFrames.length > 0 && (
                  <div class="ascii-hero__memory-photo-row">
                    {
                      group.photoFrames.map((frame, index) => (
                        <figure
                          class="ascii-hero__memory-frame"
                          data-memory-frame
                          data-memory-frame-kind="photo"
                          data-memory-frame-position={index + 1}
                          role="button"
                          tabindex="0"
                          aria-pressed="false"
                          style={`--memory-frame-index: ${index}; --memory-frame-collapsed-right: calc(var(--memory-frame-width) * ${(group.photoFrames.length - index - 1) * 0.64}); --memory-frame-expanded-right: calc((var(--memory-frame-width) + var(--memory-frame-hover-gap)) * ${group.photoFrames.length - index - 1});`}
                        >
                          <svg
                            class="ascii-hero__memory-shield"
                            viewBox="0 -10 64 88"
                            preserveAspectRatio="none"
                            aria-hidden={frame.src ? "true" : undefined}
                            focusable="false"
                          >
                            <defs>
                              <clipPath
                                id={`memory-frame-clip-${group.dispatchIndex}-${index}`}
                                clipPathUnits="userSpaceOnUse"
                              >
                                <path d={scalePath} />
                              </clipPath>
                            </defs>
                            <path class="ascii-hero__memory-frame-backdrop" d={scalePath} />
                            {
                              frame.src ? (
                                <image
                                  class="ascii-hero__memory-frame-image"
                                  href={frame.src}
                                  x="-1"
                                  y="-11"
                                  width="66"
                                  height="90"
                                  preserveAspectRatio="xMidYMid slice"
                                  clip-path={`url(#memory-frame-clip-${group.dispatchIndex}-${index})`}
                                >
                                  <title>{frame.alt}</title>
                                </image>
                              ) : (
                                <path
                                  class="ascii-hero__memory-frame-placeholder"
                                  d={scalePath}
                                />
                              )
                            }
                            <path class="ascii-hero__memory-frame-stroke" d={scalePath} />
                          </svg>
                          <figcaption class="sr-only">{frame.alt}</figcaption>
                        </figure>
                      ))
                    }
                  </div>
                )
              }
              {
                group.videoFrames.length > 0 && (
                  <div class="ascii-hero__memory-video-row">
                    {
                      group.videoFrames.map((frame) => (
                        <figure
                          class="ascii-hero__memory-video-card"
                          data-dispatch-proof-card
                          data-dispatch-video-index={group.dispatchIndex}
                          data-dispatch-enter-src={frame.enterSrc ?? frame.src}
                          data-dispatch-exit-src={frame.exitSrc ?? frame.src}
                          style={`--proof-video-aspect: ${frame.aspectRatio ?? "16 / 9"};`}
                        >
                          <video
                            class="ascii-hero__proof-video ascii-hero__proof-video--enter"
                            data-dispatch-proof-enter
                            src={frame.enterSrc ?? frame.src}
                            muted
                            playsinline
                            preload="auto"
                            aria-label={`${frame.alt} intro`}
                          />
                          <video
                            class="ascii-hero__proof-video ascii-hero__proof-video--exit"
                            data-dispatch-proof-exit
                            src={frame.exitSrc ?? frame.src}
                            muted
                            playsinline
                            preload="auto"
                            aria-label={`${frame.alt} outro`}
                          />
                          <figcaption class="sr-only">{frame.alt}</figcaption>
                        </figure>
                      ))
                    }
                  </div>
                )
              }
            </div>
            );
          })
        }
      </div>
    </div>

    <div
      class="ascii-hero__memory-lightbox"
      data-memory-lightbox
      aria-hidden="true"
    >
      <div
        class="ascii-hero__memory-lightbox-frame"
        data-memory-lightbox-frame
        role="img"
        aria-label="Selected image preview"
      >
        <img
          class="ascii-hero__memory-lightbox-image"
          data-memory-lightbox-image
          alt=""
        />
        <span class="sr-only" data-memory-lightbox-caption>Selected childhood image</span>
      </div>
    </div>

    <aside class="ascii-hero__age-timeline" aria-label="Age timeline">
      <p class="ascii-hero__age-title">Age</p>
      <ol class="ascii-hero__age-list">
        {
          heroDispatches.map((dispatch, index) => (
            <li
              class="ascii-hero__age-item"
              data-hero-age
              data-age-index={index}
              style={`--age-index: ${index};`}
            >
              <svg
                class="ascii-hero__age-scale"
                viewBox="0 -10 64 88"
                preserveAspectRatio="none"
                aria-hidden="true"
                focusable="false"
              >
                <path d={scalePath} />
              </svg>
              <span class="ascii-hero__age-value">{dispatch.age}</span>
            </li>
          ))
        }
      </ol>
    </aside>
  </div>

  <video
    data-ascii-video
    src="/cobra-ascii.mp4"
    muted
    playsinline
    preload="auto"
  ></video>
  <canvas data-ascii-canvas></canvas>
</section>

<script>
  const asciiHeroSections =
    document.querySelectorAll<HTMLElement>("[data-ascii-hero]");
  const glyphRamp =
    ".:-=+*#%@";
  const fieldGlyphRamp =
    ".::---===+++***###%%%@@";
  const luminanceFloor = 0.1;
  const foregroundBoost = 1.18;
  const introScrollShare = 0.24;
  const postIntroStartShare = introScrollShare + 0.04;
  const snakeMotionStartShare = introScrollShare * 0.58;
  const dispatchStartShare = 0.34;
  const dispatchEndShare = 0.995;
  const borderColor = [0x33, 0x45, 0x3d];
  const signalColor = [0xd9, 0xc7, 0x7d];

  const clamp = (value: number, min: number, max: number) =>
    Math.min(Math.max(value, min), max);

  const smoothstep = (edge0: number, edge1: number, value: number) => {
    const amount = clamp((value - edge0) / (edge1 - edge0), 0, 1);

    return amount * amount * (3 - 2 * amount);
  };

  const mixChannel = (from: number, to: number, amount: number) =>
    Math.round(from + (to - from) * amount)
      .toString(16)
      .padStart(2, "0");

  const mixColor = (from: number[], to: number[], amount: number) =>
    `#${mixChannel(from[0], to[0], amount)}${mixChannel(from[1], to[1], amount)}${mixChannel(from[2], to[2], amount)}`;

  asciiHeroSections.forEach((section) => {
    const video = section.querySelector<HTMLVideoElement>("[data-ascii-video]");
    const canvas = section.querySelector<HTMLCanvasElement>("[data-ascii-canvas]");
    const output = section.querySelector<HTMLElement>("[data-ascii-output]");
    const readout = section.querySelector<HTMLElement>("[data-ascii-readout]");
    const stage = section.querySelector<HTMLElement>(".ascii-hero__sticky");
    const dispatches =
      Array.from(section.querySelectorAll<HTMLElement>("[data-hero-dispatch]"));
    const dispatchScrollWeights = dispatches.map((dispatch) =>
      Math.max(Number(dispatch.dataset.dispatchScrollWeight) || 1, 0.25),
    );
    const totalDispatchScrollWeight =
      dispatchScrollWeights.reduce((total, weight) => total + weight, 0) || dispatches.length || 1;
    const ageItems =
      Array.from(section.querySelectorAll<HTMLElement>("[data-hero-age]"));
    const memoryFrameContainers =
      Array.from(section.querySelectorAll<HTMLElement>("[data-memory-frames]"));
    const memoryFrameGroups =
      Array.from(section.querySelectorAll<HTMLElement>("[data-memory-frame-group]"));
    const memoryFrameItems =
      Array.from(section.querySelectorAll<HTMLElement>("[data-memory-frame]"));
    const dispatchProofCards =
      Array.from(section.querySelectorAll<HTMLElement>("[data-dispatch-proof-card]"));
    const memoryLightbox =
      section.querySelector<HTMLElement>("[data-memory-lightbox]");
    const memoryLightboxFrame =
      section.querySelector<HTMLElement>("[data-memory-lightbox-frame]");
    const memoryLightboxImage =
      section.querySelector<HTMLImageElement>("[data-memory-lightbox-image]");
    const memoryLightboxCaption =
      section.querySelector<HTMLElement>("[data-memory-lightbox-caption]");
    const context = canvas?.getContext("2d");
    if (!video || !canvas || !output || !readout || !stage || !context) {
      return;
    }

    const compactMediaQuery = window.matchMedia("(max-width: 680px)");
    const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    let duration = 0;
    let pendingTime = 0;
    let isSeeking = false;
    let scrollQueued = false;
    let idleTextureInterval: number | undefined;
    let lastMotionAt = performance.now();
    let texturePhase = 0;
    let currentIntroProgress = 0;
    let videoDrawRect = { x: 0, y: 0, width: 0, height: 0 };
    let selectedMemoryFrame: HTMLElement | null = null;
    let activeMemoryGroups: HTMLElement[] = [];
    const proofVideoStates = new WeakMap<HTMLElement, string>();
    type ProofSegment = "enter" | "exit";
    const proofVideoActiveStates = new WeakMap<HTMLElement, boolean>();
    const proofVideoQueues = new WeakMap<HTMLElement, ProofSegment[]>();

    const setOutput = (text: string) => {
      output.textContent = text;
    };

    const getFieldNoise = (x: number, y: number, salt: number) => {
      const value =
        Math.sin((x + 3) * 19.19 + (y + 5) * 37.37 + salt * 101.01) * 43758.5453;

      return value - Math.floor(value);
    };

    const clearMemorySelection = () => {
      selectedMemoryFrame = null;
      memoryFrameContainers.forEach((container) => container.classList.remove("has-selected"));
      memoryFrameGroups.forEach((group) => group.classList.remove("has-selected"));
      memoryLightbox?.classList.remove("is-active");
      memoryLightbox?.classList.remove("is-logo");
      memoryLightbox?.setAttribute("aria-hidden", "true");
      memoryLightboxImage?.removeAttribute("src");
      memoryLightboxImage?.setAttribute("alt", "");
      memoryFrameItems.forEach((frame) => {
        frame.classList.remove("is-selected");
        frame.setAttribute("aria-pressed", "false");
      });
    };

    const getFrameGroup = (frame: HTMLElement) =>
      frame.closest("[data-memory-frame-group]") as HTMLElement | null;

    const getActiveMemoryFrameItems = (frame: HTMLElement) => {
      const group = getFrameGroup(frame);

      if (!group || !group.classList.contains("is-active")) return [];

      return Array.from(group.querySelectorAll<HTMLElement>("[data-memory-frame]"));
    };

    const getMemoryFramePreview = (frame: HTMLElement) => {
      const image = frame.querySelector<SVGImageElement>("image");
      const caption = frame.querySelector<HTMLElement>("figcaption");

      return {
        href: image?.getAttribute("href") || "",
        alt: caption?.textContent?.trim() || "Selected image",
      };
    };

    const selectMemoryFrame = (frame: HTMLElement) => {
      const frameGroup = getFrameGroup(frame);
      const activeItems = getActiveMemoryFrameItems(frame);
      const nextIndex = activeItems.indexOf(frame);

      if (!frameGroup || nextIndex < 0) return;

      if (selectedMemoryFrame === frame) {
        clearMemorySelection();
        return;
      }

      selectedMemoryFrame = frame;
      memoryFrameContainers.forEach((container) => container.classList.add("has-selected"));
      memoryFrameGroups.forEach((group) => {
        group.classList.toggle("has-selected", group === frameGroup);
      });
      memoryFrameItems.forEach((item) => {
        const isSelected = item === frame;

        item.classList.toggle("is-selected", isSelected);
        item.setAttribute("aria-pressed", isSelected ? "true" : "false");
      });

      const isLogoFrame = frame.dataset.memoryFrameKind === "logo";
      const preview = getMemoryFramePreview(frame);

      if (memoryLightboxImage && preview.href) {
        memoryLightboxImage.src = preview.href;
        memoryLightboxImage.alt = preview.alt;
      }

      if (memoryLightboxCaption) {
        memoryLightboxCaption.textContent = preview.alt;
      }

      memoryLightbox?.classList.add("is-active");
      memoryLightbox?.classList.toggle("is-logo", isLogoFrame);
      memoryLightbox?.setAttribute("aria-hidden", "false");
    };

    memoryFrameItems.forEach((frame) => {
      frame.addEventListener("click", (event) => {
        event.stopPropagation();
        selectMemoryFrame(frame);
      });

      frame.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;

        event.preventDefault();
        selectMemoryFrame(frame);
      });
    });

    document.addEventListener("click", (event) => {
      if (!selectedMemoryFrame) return;
      if (memoryFrameContainers.some((container) => container.contains(event.target as Node))) {
        return;
      }

      clearMemorySelection();
    });

    memoryLightbox?.addEventListener("click", () => {
      clearMemorySelection();
    });

    memoryLightboxFrame?.addEventListener("click", (event) => {
      event.stopPropagation();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        clearMemorySelection();
      }
    });

    const setProofVideoState = (card: HTMLElement, state: string) => {
      proofVideoStates.set(card, state);
      card.dataset.proofVideoState = state;
      card.classList.toggle("is-entering", state === "entering");
      card.classList.toggle("is-held", state === "held");
      card.classList.toggle("is-exiting", state === "exiting");
      card.classList.toggle("is-exited", state === "exited");
    };

    const getCurrentProofSegment = (card: HTMLElement): ProofSegment | null => {
      const state = proofVideoStates.get(card) ?? "idle";

      if (state === "entering") return "enter";
      if (state === "exiting") return "exit";
      return null;
    };

    const isProofVideoVisible = (card: HTMLElement) => {
      const state = proofVideoStates.get(card) ?? "idle";

      return (
        Boolean(proofVideoActiveStates.get(card)) ||
        state === "entering" ||
        state === "held" ||
        state === "exiting"
      );
    };

    const syncProofCardClass = (card: HTMLElement) => {
      card.classList.toggle("is-active", isProofVideoVisible(card));
    };

    const getProofVideo = (card: HTMLElement, segment: ProofSegment) =>
      card.querySelector<HTMLVideoElement>(
        segment === "enter" ? "[data-dispatch-proof-enter]" : "[data-dispatch-proof-exit]",
      );

    const getProofVideos = (card: HTMLElement) =>
      [
        card.querySelector<HTMLVideoElement>("[data-dispatch-proof-enter]"),
        card.querySelector<HTMLVideoElement>("[data-dispatch-proof-exit]"),
      ].filter(Boolean) as HTMLVideoElement[];

    const setProofVideoTime = (video: HTMLVideoElement, time: number) => {
      const applyTime = () => {
        try {
          video.currentTime = Math.max(0, time);
        } catch {
          // Some browsers reject seeks before metadata is settled.
        }
      };

      if (video.readyState) {
        applyTime();
      } else {
        video.addEventListener("loadedmetadata", applyTime, { once: true });
      }
    };

    const resetProofCard = (card: HTMLElement) => {
      proofVideoActiveStates.set(card, false);
      proofVideoQueues.delete(card);

      getProofVideos(card).forEach((video) => {
        video.pause();
        setProofVideoTime(video, 0);
      });

      setProofVideoState(card, "idle");
      syncProofCardClass(card);
    };

    const enqueueProofSegment = (card: HTMLElement, segment: ProofSegment) => {
      const queue = proofVideoQueues.get(card) ?? [];
      const lastQueued = queue[queue.length - 1];
      const currentSegment = getCurrentProofSegment(card);
      const lastSegment = lastQueued ?? currentSegment;

      if (lastSegment === segment) return;

      queue.push(segment);
      proofVideoQueues.set(card, queue);
    };

    const takeQueuedProofSegment = (card: HTMLElement) => {
      const queue = proofVideoQueues.get(card);
      const nextSegment = queue?.shift();

      if (!queue?.length) {
        proofVideoQueues.delete(card);
      }

      return nextSegment;
    };

    const playProofSegment = (card: HTMLElement, segment: ProofSegment) => {
      const video = getProofVideo(card, segment);
      if (!video) return;

      const state = segment === "enter" ? "entering" : "exiting";

      video.pause();

      const beginPlayback = () => {
        setProofVideoTime(video, 0);
        requestAnimationFrame(() => {
          setProofVideoState(card, state);
          syncProofCardClass(card);
          video.play().catch(() => undefined);
        });
      };

      if (video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
        beginPlayback();
      } else {
        video.addEventListener("loadeddata", beginPlayback, { once: true });
      }
    };

    const requestProofSegment = (card: HTMLElement, segment: ProofSegment) => {
      const currentSegment = getCurrentProofSegment(card);

      if (currentSegment) {
        enqueueProofSegment(card, segment);
        return;
      }

      playProofSegment(card, segment);
    };

    dispatchProofCards.forEach((card) => {
      setProofVideoState(card, "idle");
      proofVideoActiveStates.set(card, false);

      (["enter", "exit"] as ProofSegment[]).forEach((segment) => {
        const video = getProofVideo(card, segment);

        video?.load();

        video?.addEventListener("ended", () => {
          const state = proofVideoStates.get(card);
          const nextSegment = takeQueuedProofSegment(card);

          if (segment === "enter" && state === "entering") {
            setProofVideoState(card, "held");
          }

          if (segment === "exit" && state === "exiting") {
            setProofVideoState(card, "exited");
          }

          syncProofCardClass(card);

          if (nextSegment) {
            requestAnimationFrame(() => requestProofSegment(card, nextSegment));
          }
        });
      });
    });

    const updateDispatches = (progress: number) => {
      if (!dispatches.length) return;

      const isCompactStack = compactMediaQuery.matches;
      const effectiveDispatchStartShare = isCompactStack
        ? postIntroStartShare
        : dispatchStartShare;
      const rawDispatchProgress = clamp(
        (progress - effectiveDispatchStartShare) / (dispatchEndShare - effectiveDispatchStartShare),
        0,
        1,
      );
      const hasStarted = progress >= effectiveDispatchStartShare;
      const weightedDispatchProgress = rawDispatchProgress * totalDispatchScrollWeight;
      let accumulatedDispatchWeight = 0;
      let resolvedActiveIndex = -1;
      let resolvedSegmentProgress = 0;

      if (hasStarted) {
        for (let index = 0; index < dispatches.length; index += 1) {
          const weight = dispatchScrollWeights[index] || 1;
          const isLast = index === dispatches.length - 1;

          if (weightedDispatchProgress <= accumulatedDispatchWeight + weight || isLast) {
            resolvedActiveIndex = index;
            resolvedSegmentProgress = clamp(
              (weightedDispatchProgress - accumulatedDispatchWeight) / weight,
              0,
              1,
            );
            break;
          }

          accumulatedDispatchWeight += weight;
        }
      }

      const activeIndex = resolvedActiveIndex;
      const activeAgeIndex = Math.max(activeIndex, 0);
      const segmentProgress = activeIndex >= 0 ? resolvedSegmentProgress : 0;
      const columnIntroOpacity = smoothstep(0, 0.025, rawDispatchProgress);
      const columnExitOpacity = 1 - smoothstep(0.968, 1, rawDispatchProgress);
      const columnOpacity = hasStarted
        ? clamp(columnIntroOpacity * columnExitOpacity, 0, 1)
        : 0;
      const stackDepth = isCompactStack ? 1 : 4;
      const stackStates = [
        { content: 1 },
        { content: 0.82 },
        { content: 0.28 },
        { content: 0 },
        { content: 0 },
      ];
      const mobileCardWidth = isCompactStack
        ? window.innerWidth <= 430
          ? Math.min((window.innerWidth || 390) * 0.88, 360)
          : Math.min((window.innerWidth || 390) * 0.86, 390)
        : 0;
      const mobileSlideProgress = smoothstep(0.74, 1, segmentProgress);

      section.style.setProperty("--active-dispatch", `${activeIndex}`);
      section.style.setProperty("--age-progress", rawDispatchProgress.toFixed(3));
      section.style.setProperty("--dispatch-grid-opacity", columnOpacity.toFixed(3));
      const nextActiveMemoryGroups = memoryFrameGroups.filter((group) =>
        Number(group.dataset.memoryDispatchIndex) === activeIndex
      );
      const baseMemoryFramesVisible = nextActiveMemoryGroups.length > 0 && columnOpacity > 0.08;

      dispatchProofCards.forEach((card) => {
        const videoDispatchIndex = Number(card.dataset.dispatchVideoIndex);
        const isActiveVideo = baseMemoryFramesVisible && videoDispatchIndex === activeIndex;
        const wasActiveVideo = Boolean(proofVideoActiveStates.get(card));
        const state = proofVideoStates.get(card) ?? "idle";

        if (reducedMotionQuery.matches) {
          if (isActiveVideo && state !== "held") {
            const video = getProofVideo(card, "enter");

            if (video) {
              getProofVideo(card, "exit")?.pause();

              const seekToEnd = () => {
                const endTime = Number.isFinite(video.duration) && video.duration > 0
                  ? Math.max(video.duration - 0.03, 0)
                  : 0;

                setProofVideoTime(video, endTime);
              };

              if (video.readyState) {
                seekToEnd();
              } else {
                video.addEventListener("loadedmetadata", seekToEnd, { once: true });
              }
            }

            proofVideoActiveStates.set(card, true);
            setProofVideoState(card, "held");
            syncProofCardClass(card);
          }

          if (!isActiveVideo && wasActiveVideo) {
            resetProofCard(card);
          }
          return;
        }

        if (isActiveVideo && !wasActiveVideo) {
          proofVideoActiveStates.set(card, true);
          requestProofSegment(card, "enter");
        }

        if (!isActiveVideo && wasActiveVideo) {
          proofVideoActiveStates.set(card, false);
          requestProofSegment(card, "exit");
        }

        syncProofCardClass(card);
      });

      const proofVisibleDispatchIndexes = new Set(
        dispatchProofCards
          .filter((card) => isProofVideoVisible(card))
          .map((card) => Number(card.dataset.dispatchVideoIndex)),
      );
      const proofFramesVisible = proofVisibleDispatchIndexes.size > 0;
      const memoryFramesVisible = baseMemoryFramesVisible || proofFramesVisible;
      const memoryFramesOpacity = proofFramesVisible
        ? Math.max(columnOpacity, 1)
        : baseMemoryFramesVisible
          ? columnOpacity
          : 0;

      section.style.setProperty(
        "--memory-frames-opacity",
        memoryFramesVisible ? memoryFramesOpacity.toFixed(3) : "0",
      );
      memoryFrameContainers.forEach((container) => {
        container.classList.toggle("is-visible", memoryFramesVisible);
      });
      memoryFrameGroups.forEach((group) => {
        const groupDispatchIndex = Number(group.dataset.memoryDispatchIndex);
        const isActiveGroup =
          (baseMemoryFramesVisible && nextActiveMemoryGroups.includes(group)) ||
          (group.dataset.memoryGroupKind === "video" && proofVisibleDispatchIndexes.has(groupDispatchIndex));

        group.classList.toggle("is-active", isActiveGroup);
        group.setAttribute("aria-hidden", isActiveGroup ? "false" : "true");
      });
      activeMemoryGroups = memoryFramesVisible
        ? memoryFrameGroups.filter((group) => group.classList.contains("is-active"))
        : [];

      const selectedMemoryGroup = selectedMemoryFrame ? getFrameGroup(selectedMemoryFrame) : null;
      if (
        !memoryFramesVisible ||
        (selectedMemoryGroup && !activeMemoryGroups.includes(selectedMemoryGroup))
      ) {
        clearMemorySelection();
      }

      dispatches.forEach((dispatch, index) => {
        const stackIndex = index - activeIndex;
        const isActive = hasStarted && stackIndex === 0;
        const isStacked = hasStarted && stackIndex > 0 && stackIndex <= stackDepth;
        const isVisible = isActive || isStacked;
        const state = stackStates[stackIndex] || stackStates[stackStates.length - 1];
        const stackReveal = (() => {
          if (stackIndex <= 1) return 1;

          const revealStart = Math.max(stackIndex - 2, 0) * 0.08;
          const revealEnd = 0.32 + Math.max(stackIndex - 2, 0) * 0.08;

          return smoothstep(revealStart, revealEnd, segmentProgress);
        })();
        const cardOpacity = isVisible ? columnOpacity * stackReveal : 0;
        const contentOpacity = isVisible
          ? state.content * stackReveal
          : 0;
        const mobileSlideX = (() => {
          if (!isCompactStack || !hasStarted) return 0;

          const slidePosition = stackIndex === 0
            ? -mobileSlideProgress
            : stackIndex === 1
              ? 1 - mobileSlideProgress
              : stackIndex;

          return clamp(slidePosition * mobileCardWidth, mobileCardWidth * -1.12, mobileCardWidth * 1.12);
        })();
        const mobilePanelOpacity = (() => {
          if (!isCompactStack || !hasStarted) return cardOpacity;
          if (stackIndex === 0 || stackIndex === 1) return columnOpacity;

          return 0;
        })();

        dispatch.classList.toggle("is-active", isActive);
        dispatch.classList.toggle("is-stacked", isStacked);
        dispatch.classList.toggle("is-skeleton", isVisible && stackIndex >= 3);
        dispatch.setAttribute("aria-hidden", isActive ? "false" : "true");
        dispatch.style.setProperty(
          "--dispatch-opacity",
          (isCompactStack ? mobilePanelOpacity : cardOpacity).toFixed(3),
        );
        dispatch.style.setProperty("--dispatch-stack-index", `${Math.max(stackIndex, 0)}`);
        dispatch.style.setProperty("--dispatch-y", "0px");
        dispatch.style.setProperty("--dispatch-x", `${mobileSlideX.toFixed(2)}px`);
        dispatch.style.setProperty("--dispatch-content-opacity", contentOpacity.toFixed(3));
        dispatch.style.setProperty("--dispatch-progress", isActive ? segmentProgress.toFixed(3) : "0");
      });

      ageItems.forEach((item, index) => {
        const isActive = index === activeAgeIndex;
        const isPast = index < activeAgeIndex;
        const lineProgress = index < activeAgeIndex
          ? 1
          : index === activeAgeIndex && activeIndex >= 0
            ? smoothstep(0.12, 0.96, segmentProgress)
            : 0;

        item.classList.toggle("is-active", isActive);
        item.classList.toggle("is-past", isPast);
        item.setAttribute("aria-current", isActive ? "step" : "false");
        item.style.setProperty("--age-segment-progress", lineProgress.toFixed(3));
        item.style.setProperty("--age-segment-slide", `${((1 - lineProgress) * 4).toFixed(2)}px`);
      });
    };

    const updateHeroState = (progress: number) => {
      section.style.setProperty("--ascii-hero-progress", progress.toFixed(3));

      const rawIntroProgress = clamp(progress / introScrollShare, 0, 1);
      const introProgress = smoothstep(0, 1, rawIntroProgress);
      const ageTimelineOpacity = smoothstep(postIntroStartShare, dispatchStartShare, progress);
      const outputOffset = (() => {
        if (compactMediaQuery.matches) return 0;

        const viewportWidth = window.innerWidth || stage.clientWidth || 1280;
        const finalOffset = clamp(viewportWidth * -0.11, -220, -120);
        const offsetProgress = smoothstep(postIntroStartShare, 0.52, progress);

        return finalOffset * offsetProgress;
      })();

      currentIntroProgress = introProgress;
      section.style.setProperty("--ascii-intro-progress", introProgress.toFixed(3));
      stage.style.setProperty("--ascii-output-offset-x", `${outputOffset.toFixed(2)}px`);
      section.style.setProperty("--age-timeline-opacity", ageTimelineOpacity.toFixed(3));
      section.style.setProperty("--ascii-copy-opacity", "1");
      section.style.setProperty("--ascii-copy-y", "0px");
      section.style.setProperty("--ascii-snake-color", mixColor(borderColor, signalColor, introProgress));
      updateDispatches(progress);
    };

    const updateReadout = (progress: number, time: number) => {
      section.style.setProperty("--ascii-hero-progress", progress.toFixed(3));

      if (!duration) {
        readout.textContent = "Scroll to advance the signal.";
        return;
      }

      readout.textContent = `${Math.round(progress * 100)
        .toString()
        .padStart(2, "0")}% / ${time.toFixed(2)}s`;
    };

    const getScrollProgress = () => {
      const start = section.offsetTop;
      const end = section.offsetTop + section.offsetHeight - window.innerHeight;

      if (end <= start) return 0;
      return clamp((window.scrollY - start) / (end - start), 0, 1);
    };

    const getHeroExitProgress = () => {
      const start = section.offsetTop;
      const end = section.offsetTop + section.offsetHeight;

      if (end <= start) return 0;
      return clamp((window.scrollY - start) / (end - start), 0, 1);
    };

    const resizeCanvas = () => {
      const stageHeight = stage.clientHeight || window.innerHeight;
      const stageWidth = stage.clientWidth || window.innerWidth;
      const cellWidthRatio = 0.6;
      const lineHeightRatio = 0.84;
      const isCompactRender = compactMediaQuery.matches;
      const videoAspect = video.videoWidth && video.videoHeight
        ? video.videoWidth / video.videoHeight
        : 9 / 16;
      const rows = Math.round(
        isCompactRender
          ? clamp(stageHeight / 8.3, 74, 112)
          : clamp(stageHeight / 6.6, 96, 154),
      );
      const fontSize = stageHeight / (rows * lineHeightRatio);
      const asciiFieldWidth = isCompactRender
        ? Math.max(window.innerWidth || 0, stageWidth) + fontSize * 4
        : stageWidth;
      const fullWidthColumns = Math.ceil(asciiFieldWidth / (fontSize * cellWidthRatio));
      const nativeSnakeColumns = Math.round(rows * videoAspect * (lineHeightRatio / cellWidthRatio));
      const columns = Math.round(
        isCompactRender
          ? clamp(fullWidthColumns, 54, 190)
          : clamp(fullWidthColumns, 72, 320),
      );
      const drawWidth = Math.min(nativeSnakeColumns, columns);

      canvas.width = columns;
      canvas.height = rows;
      videoDrawRect = {
        x: Math.round((columns - drawWidth) / 2),
        y: 0,
        width: drawWidth,
        height: rows,
      };
      stage.style.setProperty("--ascii-hero-font-size", `${fontSize.toFixed(2)}px`);
    };

    const getSnakeSignal = (
      red: number,
      green: number,
      blue: number,
      luminance: number,
    ) => {
      const maxChannel = Math.max(red, green, blue);
      const minChannel = Math.min(red, green, blue);
      const saturation = maxChannel === 0 ? 0 : (maxChannel - minChannel) / maxChannel;
      const warmth = (red - blue) / 255;
      const goldBalance = (red + green * 0.68 - blue * 1.45) / 255;
      const isWarmScale = warmth > 0.055 && goldBalance > 0.075;
      const isBrightBelly = luminance > 0.32 && warmth > 0.02 && red >= green * 0.82;
      const isShadowedScale =
        saturation > 0.12 && warmth > 0 && red > blue + 5 && green >= blue;

      if (
        luminance < luminanceFloor ||
        (!isWarmScale && !isBrightBelly && !isShadowedScale)
      ) {
        return 0;
      }

      return clamp(
        goldBalance * 0.95 + saturation * 0.52 + (luminance - luminanceFloor) * 0.7,
        0,
        1,
      );
    };

    const getTextureNoise = (x: number, y: number, phase: number) => {
      const value = Math.sin((x + 1) * 17.17 + (y + 1) * 43.43 + phase * 11.31) * 43758.5453;

      return value - Math.floor(value);
    };

    const renderFrame = (phase = 0) => {
      if (!video.videoWidth || !canvas.width || !canvas.height) return;

      const width = canvas.width;
      const height = canvas.height;

      context.fillStyle = "#000000";
      context.fillRect(0, 0, width, height);
      context.drawImage(
        video,
        videoDrawRect.x,
        videoDrawRect.y,
        videoDrawRect.width,
        videoDrawRect.height,
      );

      const { data } = context.getImageData(0, 0, width, height);
      const luminanceMap = new Float32Array(width * height);
      const signalMap = new Float32Array(width * height);
      const composedCells = new Array<string>(width * height).fill(" ");
      const composedStrength = new Float32Array(width * height);
      const lines: string[] = [];

      for (let index = 0; index < signalMap.length; index += 1) {
        const dataIndex = index * 4;
        const red = data[dataIndex];
        const green = data[dataIndex + 1];
        const blue = data[dataIndex + 2];
        const luminance = (0.2126 * red + 0.7152 * green + 0.0722 * blue) / 255;

        luminanceMap[index] = luminance;
        signalMap[index] = getSnakeSignal(red, green, blue, luminance);
      }

      const getLocalContrast = (x: number, y: number, luminance: number) => {
        let contrast = 0;

        for (let offsetY = -1; offsetY <= 1; offsetY += 1) {
          for (let offsetX = -1; offsetX <= 1; offsetX += 1) {
            if (!offsetX && !offsetY) continue;

            const neighborX = x + offsetX;
            const neighborY = y + offsetY;

            if (neighborX < 0 || neighborX >= width || neighborY < 0 || neighborY >= height) {
              continue;
            }

            contrast = Math.max(
              contrast,
              Math.abs(luminance - luminanceMap[neighborY * width + neighborX]),
            );
          }
        }

        return contrast;
      };

      const getNeighborSignal = (x: number, y: number) => {
        let signal = 0;

        for (let offsetY = -1; offsetY <= 1; offsetY += 1) {
          for (let offsetX = -1; offsetX <= 1; offsetX += 1) {
            const neighborX = x + offsetX;
            const neighborY = y + offsetY;

            if (neighborX < 0 || neighborX >= width || neighborY < 0 || neighborY >= height) {
              continue;
            }

            signal = Math.max(signal, signalMap[neighborY * width + neighborX]);
          }
        }

        return signal;
      };

      const getSourcePoint = (x: number, y: number, phase = 0) => {
        const sourceXNoise = getFieldNoise(x, y, 7);
        const sourceYNoise = getFieldNoise(x, y, 13);
        const jitterGate = phase && getTextureNoise(x, y, phase * 0.19) > 0.992;
        const jitterStrength = jitterGate ? Math.max(0, 1 - currentIntroProgress) * 0.7 : 0;
        const jitterX = Math.round((getTextureNoise(x, y, phase * 0.61) - 0.5) * 1.4 * jitterStrength);
        const jitterY = Math.round((getTextureNoise(x, y, phase * 0.83) - 0.5) * 1.2 * jitterStrength);

        return {
          x: clamp(Math.floor(sourceXNoise * width) + jitterX, 0, width - 1),
          y: clamp(Math.floor(sourceYNoise * height) + jitterY, 0, height - 1),
        };
      };

      const placeComposedCell = (
        x: number,
        y: number,
        glyph: string,
        strength: number,
      ) => {
        if (x < 0 || x >= width || y < 0 || y >= height) return;

        const index = y * width + x;

        if (strength < composedStrength[index]) return;

        composedCells[index] = glyph;
        composedStrength[index] = strength;
      };

      const assemblyProgress = currentIntroProgress;
      const assemblyEase = smoothstep(0, 1, assemblyProgress);

      for (let y = 0; y < height; y += 1) {
        for (let x = 0; x < width; x += 1) {
          const index = y * width + x;
          const luminance = luminanceMap[index];
          const localContrast = getLocalContrast(x, y, luminance);
          const neighborSignal = getNeighborSignal(x, y);
          const snakeSignal =
            signalMap[index] ||
            (neighborSignal > 0.18 && localContrast > 0.035 && luminance > luminanceFloor
              ? clamp(neighborSignal * 0.32 + localContrast * 2.2, 0.08, 0.62)
              : 0);

          if (!snakeSignal) {
            continue;
          }

          const textureNoise = phase ? getTextureNoise(x, y, phase) : 0.5;
          const textureAmount = phase
            ? 0.035 * clamp(snakeSignal + localContrast * 2, 0.25, 1)
            : 0;
          const shaped = clamp(
            (((luminance - luminanceFloor) / (1 - luminanceFloor)) * 0.58 +
              snakeSignal * 0.34 +
              localContrast * 1.2) *
              foregroundBoost +
              (textureNoise - 0.5) * textureAmount,
            0,
            1,
          );
          const glyphIndex = Math.round(shaped * (glyphRamp.length - 1));
          const targetGlyph = glyphRamp[glyphIndex];

          if (assemblyProgress >= 0.995) {
            placeComposedCell(x, y, targetGlyph, shaped + 1);
            continue;
          }

          const source = getSourcePoint(x, y, phase);
          const assembleDelay = getFieldNoise(x, y, 23) * 0.22;
          const localAssembly = smoothstep(assembleDelay, 1, assemblyEase);
          const composedX = Math.round(source.x + (x - source.x) * localAssembly);
          const composedY = Math.round(source.y + (y - source.y) * localAssembly);
          const baseSourceGlyphIndex = Math.floor(getFieldNoise(x, y, 31) * fieldGlyphRamp.length);
          const glyphNoise = phase ? getTextureNoise(x, y, phase * 0.47) : 0;
          const glyphShift =
            assemblyProgress < 0.55 && glyphNoise > 0.982
              ? 1
              : 0;
          const sourceGlyphIndex = (baseSourceGlyphIndex + glyphShift) % fieldGlyphRamp.length;
          const glyphSwitch = smoothstep(0.46, 0.92, localAssembly);
          const glyph =
            glyphSwitch > getFieldNoise(x, y, 37)
              ? targetGlyph
              : fieldGlyphRamp[sourceGlyphIndex] || ".";
          const strength = shaped + localAssembly + snakeSignal;

          placeComposedCell(composedX, composedY, glyph, strength);
        }
      }

      for (let y = 0; y < height; y += 1) {
        lines.push(composedCells.slice(y * width, (y + 1) * width).join(""));
      }

      setOutput(lines.join("\n"));
    };

    const seekTo = (time: number) => {
      if (!duration || Number.isNaN(time)) return;

      pendingTime = clamp(time, 0, Math.max(duration - 0.04, 0));

      if (isSeeking) return;

      isSeeking = true;
      video.currentTime = pendingTime;
    };

    const syncToScroll = () => {
      scrollQueued = false;

      if (!duration) return;

      const progress = getScrollProgress();
      const exitProgress = getHeroExitProgress();
      updateHeroState(progress);

      const snakeProgress = clamp(
        (exitProgress - snakeMotionStartShare) / (1 - snakeMotionStartShare),
        0,
        1,
      );
      const time = snakeProgress * Math.max(duration - 0.04, 0);

      updateReadout(progress, time);

      if (Math.abs(video.currentTime - time) > 0.035) {
        seekTo(time);
      } else {
        renderFrame();
      }
    };

    const queueScrollSync = () => {
      lastMotionAt = performance.now();

      if (scrollQueued) return;

      scrollQueued = true;
      window.requestAnimationFrame(syncToScroll);
    };

    const startIdleTexture = () => {
      if (idleTextureInterval || reducedMotionQuery.matches) {
        return;
      }

      const idleDelay = compactMediaQuery.matches ? 540 : 320;
      const idleInterval = compactMediaQuery.matches ? 860 : 520;

      idleTextureInterval = window.setInterval(() => {
        if (document.hidden || isSeeking || !duration) return;
        if (performance.now() - lastMotionAt < idleDelay) return;

        texturePhase += 1;
        renderFrame(texturePhase);
      }, idleInterval);
    };

    const handleMetadata = () => {
      duration = video.duration || 0;
      resizeCanvas();

      const isCompactScroll = compactMediaQuery.matches;
      const dispatchScrollVh = totalDispatchScrollWeight * (isCompactScroll ? 132 : 118);
      const videoScrollVh = duration * (isCompactScroll ? 40 : 52);
      const baseScrollVh = isCompactScroll ? 300 : 460;
      const scrollVh = clamp(
        videoScrollVh + dispatchScrollVh + baseScrollVh,
        isCompactScroll ? 1500 : 1680,
        isCompactScroll ? 2550 : 2750,
      );
      section.style.setProperty("--ascii-hero-height", `${scrollVh}svh`);
      updateHeroState(getScrollProgress());

      seekTo(0);
      queueScrollSync();
      startIdleTexture();
    };

    video.addEventListener("loadedmetadata", handleMetadata);

    video.addEventListener("loadeddata", () => {
      resizeCanvas();
      renderFrame();
      queueScrollSync();
    });

    video.addEventListener("seeked", () => {
      isSeeking = false;
      renderFrame();

      if (Math.abs(video.currentTime - pendingTime) > 0.035) {
        seekTo(pendingTime);
      }
    });

    window.addEventListener("scroll", queueScrollSync, { passive: true });
    window.addEventListener("resize", () => {
      resizeCanvas();
      queueScrollSync();
    });

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) {
        lastMotionAt = performance.now();
        queueScrollSync();
      }
    });

    if (video.readyState >= 1) {
      handleMetadata();
    } else {
      video.load();
    }
  });
</script>
