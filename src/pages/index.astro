---
import HeroAsciiSnake from "../components/HeroAsciiSnake.astro";
import FooterAsciiCobra from "../components/FooterAsciiCobra.astro";
import NorsePattern from "../components/NorsePattern.astro";
import SocialScaleStack from "../components/SocialScaleStack.astro";
import "../styles/global.css";

const siteUrl = Astro.site?.href ?? "https://benwoodward.bio/";
const canonicalUrl = new URL("/", siteUrl).toString();
const seoTitle = "Benjamin Woodward | Operator-Builder";
const seoDescription =
  "Benjamin Woodward is an operator-builder at Redo working across AI infrastructure, fintech products, automation, and go-to-market.";
const seoKeywords = [
  "Benjamin Woodward",
  "Ben Woodward",
  "operator-builder",
  "AI infrastructure",
  "fintech products",
  "automation",
  "go-to-market",
  "Redo",
  "startup operator",
  "product operator",
].join(", ");
const seoImageUrl = new URL("/og-image.png", siteUrl).toString();
const faviconUrl = new URL("/favicon.png", siteUrl).toString();
const socialProfileUrls = [
  "https://www.linkedin.com/in/woodward-ben/",
  "https://www.instagram.com/benjawo/",
  "https://x.com/benjaminbuilt",
  "https://github.com/benjaminwoodward",
];
const knowledgeAreas = [
  "AI infrastructure",
  "Fintech products",
  "Automation",
  "Go-to-market",
  "Product operations",
  "Ecommerce",
  "Fraud products",
  "Agentic systems",
];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${canonicalUrl}#person`,
      name: "Benjamin Woodward",
      alternateName: "Ben Woodward",
      url: canonicalUrl,
      image: faviconUrl,
      description: seoDescription,
      jobTitle: "Operator-builder",
      sameAs: socialProfileUrls,
      worksFor: {
        "@type": "Organization",
        name: "Redo",
      },
      knowsAbout: knowledgeAreas,
    },
    {
      "@type": "WebSite",
      "@id": `${canonicalUrl}#website`,
      url: canonicalUrl,
      name: "Benjamin Woodward",
      description: seoDescription,
      inLanguage: "en-US",
      publisher: {
        "@id": `${canonicalUrl}#person`,
      },
    },
    {
      "@type": "ProfilePage",
      "@id": `${canonicalUrl}#profile`,
      url: canonicalUrl,
      name: seoTitle,
      description: seoDescription,
      inLanguage: "en-US",
      isPartOf: {
        "@id": `${canonicalUrl}#website`,
      },
      about: {
        "@id": `${canonicalUrl}#person`,
      },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: seoImageUrl,
        width: 1200,
        height: 630,
      },
    },
  ],
};
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={seoDescription}
    />
    <meta name="author" content="Benjamin Woodward" />
    <meta name="keywords" content={seoKeywords} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="googlebot" content="index, follow" />
    <meta name="application-name" content="Benjamin Woodward" />
    <meta name="theme-color" content="#021611" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Benjamin Woodward" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={seoImageUrl} />
    <meta property="og:image:secure_url" content={seoImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Benjamin Woodward, operator-builder across AI infrastructure, fintech, automation, and go-to-market."
    />
    <meta property="profile:first_name" content="Benjamin" />
    <meta property="profile:last_name" content="Woodward" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={seoImageUrl} />
    <meta
      name="twitter:image:alt"
      content="Benjamin Woodward, operator-builder across AI infrastructure, fintech, automation, and go-to-market."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Metamorphous&display=swap"
      rel="stylesheet"
    />
    <title>{seoTitle}</title>
    <script is:inline type="application/ld+json" set:html={structuredDataJson} />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="persistent-logo" href="/" aria-label="Benjamin Woodward home">
      <img src="/benjaminwoodward.svg" alt="Benjamin Woodward" />
    </a>

    <NorsePattern side="left" />
    <NorsePattern side="right" />
    <SocialScaleStack />

    <main class="page">
      <HeroAsciiSnake />
      <FooterAsciiCobra />
    </main>

    <script>
      const revealItems = document.querySelectorAll("[data-reveal]");

      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.12 },
        );

        revealItems.forEach((item) => observer.observe(item));
      } else {
        revealItems.forEach((item) => item.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
