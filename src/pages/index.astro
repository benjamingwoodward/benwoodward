---
import Analytics from "@vercel/analytics/astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import SelectedWork from "../components/SelectedWork.astro";
import Story from "../components/Story.astro";
import SiteFooter from "../components/SiteFooter.astro";
import IntroGate from "../components/IntroGate.astro";
import IntroSplash from "../components/IntroSplash.astro";
import "../styles/global.css";
import { currentRole, socials } from "../data/profile";

const siteUrl = Astro.site?.href ?? "https://benwoodward.bio/";
const canonicalUrl = new URL("/", siteUrl).toString();
const seoTitle = "Ben Woodward | Founder & Operator";
const seoDescription =
  "Ben Woodward is a founder who built and sold Pureflow. Now GM of Coverage at Redo, leading a business line worth $750M. Explore his work and story.";
const seoImageUrl = new URL("/og-image.png", siteUrl).toString();
const socialProfileUrls = socials.map(social => social.href);
const socialImageAlt = "Ben Woodward — Founder. Now GM of Coverage at Redo. A business line worth $750M.";
const knowledgeAreas = [
  "AI infrastructure",
  "Fintech products",
  "Automation",
  "Go-to-market",
  "Product operations",
  "Ecommerce",
  "Fraud products",
  "Agentic systems",
];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${canonicalUrl}#person`,
      name: "Ben Woodward",
      givenName: "Ben",
      familyName: "Woodward",
      url: canonicalUrl,
      description: seoDescription,
      jobTitle: currentRole.title,
      mainEntityOfPage: { "@id": `${canonicalUrl}#profile` },
      sameAs: socialProfileUrls,
      worksFor: {
        "@type": "Organization",
        name: currentRole.company,
      },
      knowsAbout: knowledgeAreas,
    },
    {
      "@type": "WebSite",
      "@id": `${canonicalUrl}#website`,
      url: canonicalUrl,
      name: "Ben Woodward",
      description: seoDescription,
      inLanguage: "en-US",
      publisher: {
        "@id": `${canonicalUrl}#person`,
      },
    },
    {
      "@type": "ProfilePage",
      "@id": `${canonicalUrl}#profile`,
      url: canonicalUrl,
      name: seoTitle,
      description: seoDescription,
      inLanguage: "en-US",
      isPartOf: {
        "@id": `${canonicalUrl}#website`,
      },
      about: {
        "@id": `${canonicalUrl}#person`,
      },
      mainEntity: { "@id": `${canonicalUrl}#person` },
      hasPart: [
        { "@type": "WebPageElement", "@id": `${canonicalUrl}#work`, name: "Track record", url: `${canonicalUrl}#work` },
        { "@type": "WebPageElement", "@id": `${canonicalUrl}#story`, name: "The story so far", url: `${canonicalUrl}#story` },
      ],
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: seoImageUrl,
        width: 1200,
        height: 630,
      },
    },
  ],
};
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en" class="personal-page">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <IntroGate />
    <meta
      name="description"
      content={seoDescription}
    />
    <meta name="author" content="Ben Woodward" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="application-name" content="Ben Woodward" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Ben Woodward" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={seoImageUrl} />
    <meta property="og:image:secure_url" content={seoImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={socialImageAlt}
    />
    <meta property="profile:first_name" content="Ben" />
    <meta property="profile:last_name" content="Woodward" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@benjaminbuilt" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={seoImageUrl} />
    <meta
      name="twitter:image:alt"
      content={socialImageAlt}
    />
    <link rel="preload" href="/fonts/TWKLausanne-400.woff2" as="font" type="font/woff2" crossorigin />
    <title>{seoTitle}</title>
    <script is:inline type="application/ld+json" set:html={structuredDataJson} />
    <Analytics />
    <script is:inline>
      // Pings /api/hit so the server can log the visit; the IP comes from
      // the request itself, not from anything the browser knows. The same id
      // then carries how long the tab stayed in the foreground.
      (() => {
        const id =
          typeof crypto.randomUUID === "function"
            ? crypto.randomUUID()
            : Math.random().toString(36).slice(2) + Date.now().toString(36);

        addEventListener("load", () => {
          fetch("/api/hit", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ id, path: location.pathname, referrer: document.referrer }),
            keepalive: true,
          }).catch(() => {});
        });

        // Foreground time only: a backgrounded tab isn't a reader.
        let since = document.visibilityState === "visible" ? performance.now() : null;
        let active = 0;
        let reported = 0;

        const settle = () => {
          if (since == null) return;
          const now = performance.now();
          active += now - since;
          since = now;
        };

        const report = () => {
          settle();
          const duration = Math.round(active);
          if (duration - reported < 1000) return;
          reported = duration;
          // sendBeacon survives the page going away; fetch would not.
          navigator.sendBeacon(
            "/api/hit",
            new Blob([JSON.stringify({ id, duration })], { type: "application/json" }),
          );
        };

        document.addEventListener("visibilitychange", () => {
          if (document.visibilityState === "hidden") {
            settle();
            since = null;
            report();
          } else {
            since = performance.now();
          }
        });
        addEventListener("pagehide", report);
        // A heartbeat so a tab that never fires pagehide still counts.
        setInterval(() => since != null && report(), 20000);
      })();
    </script>
  </head>
  <body id="top" class="personal-site">
    <IntroSplash />
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <Hero />
      <SelectedWork />
      <Story />
    </main>
    <SiteFooter />
  </body>
</html>
