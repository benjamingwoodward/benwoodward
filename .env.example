# Password for /visitors (typed once; remembered by a cookie). /visitors?key=... also works.
VISITS_KEY=

# Injected automatically by the Upstash integration in the Vercel Marketplace.
# Without these the site still runs; visits just go to the Vercel logs only.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: also post each visit to a Slack or Discord incoming webhook.
VISITS_WEBHOOK_URL=
